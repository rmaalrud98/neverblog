# 이 파일을 .env 로 복사해서 채워 쓰세요 (.env 는 git에 커밋되지 않습니다).
# 클라우드(Claude Code) 환경에서는 .env 대신 Environment variables 설정에
# 아래 값들을 직접 등록하는 것을 권장합니다.

# 네이버 블로그 아이디 (기본적으로 네이버 로그인 아이디와 동일, 커스텀 URL을 쓴다면 그 값)
NAVER_BLOG_ID=

# scripts/login-setup.js 를 "본인 PC에서" 실행한 뒤 출력되는 base64 값.
# 로그인 세션(쿠키)을 담고 있으므로 절대 공개 저장소에 커밋하지 마세요.
NAVER_STORAGE_STATE_B64=
